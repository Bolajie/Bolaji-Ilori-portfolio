# Resend API key for the contact form (/api/contact).
# Create one at https://resend.com/api-keys, then paste it here for local dev.
# In production, set it in Vercel -> Project -> Settings -> Environment Variables.
RESEND_API_KEY=

# Optional. Where contact-form inquiries are delivered.
# Defaults to ibolajie@gmail.com if left unset.
CONTACT_TO_EMAIL=

# Optional. The "from" sender shown on inquiries.
# Defaults to Resend's shared test sender (onboarding@resend.dev), which delivers
# ONLY to the email that owns your Resend account. After you verify a domain in
# Resend, set this to something like: Bolaji Ilori <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
